# ==========================================
# M.A.K INDOOR POOL - ENVIRONMENT TEMPLATE
# ==========================================

# Database
# For SQLite (local dev & testing): "file:./dev.db"
# For PostgreSQL (production): "postgresql://user:password@localhost:5432/mak_pool?schema=public"
DATABASE_URL="file:./dev.db"

# Authentication & Sessions
JWT_SECRET="mak_pool_super_secret_jwt_key_development_must_change_in_production_min_32_chars"
SESSION_EXPIRY_HOURS="24"

# Application Config
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TIMEZONE="Asia/Kolkata"

# Payment Gateway (SIMULATED | RAZORPAY | STRIPE)
PAYMENT_GATEWAY_PROVIDER="SIMULATED"
PAYMENT_GATEWAY_KEY_ID="sim_key_dev_placeholder"
PAYMENT_GATEWAY_KEY_SECRET="sim_secret_dev_placeholder"
PAYMENT_WEBHOOK_SECRET="sim_webhook_secret_placeholder"

# Notifications (SIMULATED | META_CLOUD | GUPSHUP | TWILIO)
WHATSAPP_PROVIDER="SIMULATED"
WHATSAPP_API_TOKEN="placeholder_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="placeholder_phone_number_id"
SMS_PROVIDER="SIMULATED"
EMAIL_PROVIDER="SIMULATED"

# ==========================================
# DIGITAL WALLET PASSES (Apple Wallet & Google Wallet)
# ==========================================

# Apple Wallet (.pkpass Signing Credentials)
# Registered Pass Type ID (e.g. pass.com.makindoorpool.ticket)
APPLE_PASS_TYPE_IDENTIFIER="pass.com.makindoorpool.ticket"
# 10-character Apple Developer Team ID
APPLE_TEAM_IDENTIFIER="ABC123XYZ0"
# Base64-encoded .p12 certificate file (exported from macOS Keychain)
APPLE_PASS_CERTIFICATE=""
# Password used when exporting the .p12 certificate
APPLE_PASS_CERTIFICATE_PASSWORD=""
# Apple Worldwide Developer Relations (WWDR) G4/G6 Intermediate Certificate (Base64)
APPLE_WWDR_CERTIFICATE=""

# Google Wallet (Google Pay Passes JWT Signing Credentials)
# Google Wallet Business Console Issuer ID (e.g. 3388000000022345678)
GOOGLE_WALLET_ISSUER_ID=""
# Google Cloud Service Account Email
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
# PEM-formatted RSA Private Key from Google Cloud Service Account JSON
GOOGLE_WALLET_PRIVATE_KEY=""
# Optional: Google Wallet Class ID (defaults to ${GOOGLE_WALLET_ISSUER_ID}.mak_indoor_pool_pass)
GOOGLE_WALLET_CLASS_ID=""


